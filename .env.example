# Copy to .env and fill in secrets / overrides.

# Telegram
TELEGRAM_BOT_TOKEN=
# Optional comma/space separated Telegram user IDs or chat IDs. Empty means open access.
# ALLOWED_TELEGRAM_USER_IDS=123456789

# Gemini
GEMINI_API_KEY=
# Quality model for image analysis, professional Q&A, full reviews.
# GEMINI_MODEL=gemini-3.5-flash
# Fast model for text extraction, simple check-ins, and background memory consolidation.
# GEMINI_FAST_MODEL=gemini-3.1-flash-lite
# SOCKS5 via Cloudflare WARP proxy mode (warp-cli mode proxy && warp-cli connect)
# GEMINI_PROXY=socks5://127.0.0.1:40000
# professional is the default interview/demo-safe persona. Use flirty/private_coach only for personal use.
# PSMF_PERSONA_MODE=professional

# Scheduler / daily log timezone (IANA timezone, e.g. Europe/Berlin)
SCHEDULER_TIMEZONE=Europe/Berlin
# Optional override for daily_logs date bucketing; defaults to SCHEDULER_TIMEZONE
# PSMF_LOCAL_TIMEZONE=Europe/Berlin

# Fallback schedule when user profile does not yet have schedule_prefs (HH:MM)
MORNING_CHECKIN_TIME=08:00
WORKOUT_REMINDER_TIME=18:00
EVENING_REVIEW_TIME=22:00
WEEKLY_REPORT_TIME=20:00

# Weekly job weekday for WEEKLY_REPORT_TIME (cron day name, e.g. sun)
WEEKLY_REPORT_WEEKDAY=sun
